{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "-webkit-backdrop-filter",
          "user-select",
          "-moz-user-select",
          "-webkit-user-drag",
          "-ms-zoom",
          "mix-blend-mode: plus-lighter"
        ]
      }
    ]
  }
}